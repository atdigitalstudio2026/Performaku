{
  "entities": {
    "InvoiceLog": {
      "title": "InvoiceLog",
      "description": "Catatan riwayat Proforma Invoice bersama seluruh admin yang pernah dibuat, dicetak, atau diunduh sebagai PDF.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "enum": ["shared_team"],
          "minLength": 1,
          "maxLength": 128,
          "description": "Identifier ruang kerja bersama ('shared_team')."
        },
        "ownerEmail": {
          "type": "string",
          "maxLength": 200,
          "description": "Opsional label kontak/email pembuat dokumen."
        },
        "ownerName": {
          "type": "string",
          "maxLength": 120,
          "description": "Nama admin pembuat dokumen."
        },
        "actionType": {
          "type": "string",
          "enum": ["manual_save", "pdf_export", "print", "restored"],
          "description": "Jenis aktivitas saat log dibuat."
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"],
          "description": "Status arsip log invoice."
        },
        "salesName": {
          "type": "string",
          "maxLength": 120,
          "description": "Nama sales penanggung jawab Proforma Invoice."
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["pending", "paid", "cancelled"],
          "description": "Status pembayaran Proforma Invoice (hanya 'paid' yang masuk ke data penjualan sales)."
        },
        "paidAtDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^(|\\d{4}-\\d{2}-\\d{2})$",
          "description": "Tanggal pelunasan format YYYY-MM-DD (kosong jika belum lunas)."
        },
        "paymentNote": {
          "type": "string",
          "maxLength": 300,
          "description": "Catatan atau referensi transfer pembayaran / alasan pembatalan."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "cityDate": {
          "type": "string",
          "maxLength": 100
        },
        "invoiceNumber": {
          "type": "string",
          "maxLength": 80
        },
        "showInvoiceNumber": {
          "type": "boolean"
        },
        "buyerName": {
          "type": "string",
          "maxLength": 200
        },
        "buyerAddress": {
          "type": "string",
          "maxLength": 500
        },
        "sellerName": {
          "type": "string",
          "maxLength": 200
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "numberFormat": {
          "type": "string",
          "enum": ["comma", "dot"]
        },
        "ppnMode": {
          "type": "string",
          "enum": ["include", "exclude_add", "non_ppn"]
        },
        "ppnRate": {
          "type": "number"
        },
        "qtyHeader": {
          "type": "string",
          "maxLength": 50
        },
        "priceHeader": {
          "type": "string",
          "maxLength": 50
        },
        "taxLabel": {
          "type": "string",
          "maxLength": 50
        },
        "qtyUnit": {
          "type": "string",
          "maxLength": 30
        },
        "tableHeaderColor": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "shippingCost": {
          "type": "number"
        },
        "shippingLabel": {
          "type": "string",
          "maxLength": 100
        },
        "depositAmount": {
          "type": "number"
        },
        "depositLabel": {
          "type": "string",
          "maxLength": 100
        },
        "additionalNote": {
          "type": "string",
          "maxLength": 1000
        },
        "highlightTransferTotal": {
          "type": "boolean"
        },
        "showSignature": {
          "type": "boolean"
        },
        "signatureName": {
          "type": "string",
          "maxLength": 100
        },
        "signatureTitle": {
          "type": "string",
          "maxLength": 120
        },
        "itemCount": {
          "type": "integer"
        },
        "totalWeightKg": {
          "type": "number"
        },
        "subtotal": {
          "type": "number"
        },
        "ppnAmount": {
          "type": "number"
        },
        "grandTotal": {
          "type": "number"
        },
        "appliedDeposit": {
          "type": "number"
        },
        "netPayable": {
          "type": "number"
        },
        "bankAccount": {
          "type": "object"
        },
        "companySnapshot": {
          "type": "object"
        },
        "footerSnapshot": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "ownerEmail",
        "ownerName",
        "actionType",
        "status",
        "salesName",
        "paymentStatus",
        "paidAtDate",
        "paymentNote",
        "title",
        "cityDate",
        "invoiceNumber",
        "showInvoiceNumber",
        "buyerName",
        "buyerAddress",
        "sellerName",
        "currency",
        "numberFormat",
        "ppnMode",
        "ppnRate",
        "qtyHeader",
        "priceHeader",
        "taxLabel",
        "qtyUnit",
        "tableHeaderColor",
        "shippingCost",
        "shippingLabel",
        "depositAmount",
        "depositLabel",
        "additionalNote",
        "highlightTransferTotal",
        "showSignature",
        "signatureName",
        "signatureTitle",
        "itemCount",
        "totalWeightKg",
        "subtotal",
        "ppnAmount",
        "grandTotal",
        "appliedDeposit",
        "netPayable",
        "bankAccount",
        "companySnapshot",
        "footerSnapshot",
        "createdAt",
        "updatedAt"
      ]
    },
    "InvoiceLogItem": {
      "title": "InvoiceLogItem",
      "description": "Baris item barang milik sebuah dokumen log Proforma Invoice bersama.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "enum": ["shared_team"],
          "minLength": 1,
          "maxLength": 128
        },
        "logId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderIndex": {
          "type": "integer"
        },
        "namaBarang": {
          "type": "string",
          "maxLength": 200
        },
        "orderUnit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "weightPerUnit": {
          "type": "number"
        },
        "harga": {
          "type": "number"
        },
        "priceBasis": {
          "type": "string",
          "enum": ["per_kg", "per_unit"]
        },
        "qty": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "logId",
        "orderIndex",
        "namaBarang",
        "orderUnit",
        "weightPerUnit",
        "harga",
        "priceBasis",
        "qty",
        "createdAt"
      ]
    },
    "BankAccountRecord": {
      "title": "BankAccountRecord",
      "description": "Daftar rekening bank bersama seluruh admin di Firestore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "enum": ["shared_team"],
          "minLength": 1,
          "maxLength": 128
        },
        "bankName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "bankShortName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "accountHolder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "accountNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "bankName",
        "bankShortName",
        "accountHolder",
        "accountNumber",
        "createdAt",
        "updatedAt"
      ]
    },
    "InvoiceCounter": {
      "title": "InvoiceCounter",
      "description": "Penghitung nomor urut otomatis Proforma Invoice per PT per bulan agar tidak terjadi nomor ganda antar admin.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "enum": ["shared_team"],
          "minLength": 1,
          "maxLength": 128
        },
        "companyCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[A-Z0-9]+$"
        },
        "companyName": {
          "type": "string",
          "maxLength": 200
        },
        "periodKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "lastSequence": {
          "type": "integer"
        },
        "lastInvoiceNumber": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "companyCode",
        "companyName",
        "periodKey",
        "lastSequence",
        "lastInvoiceNumber",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/invoiceLogs/{logId}": {
      "schema": {
        "$ref": "#/entities/InvoiceLog"
      },
      "description": "Menyimpan riwayat dan log transaksi Proforma Invoice bersama untuk semua admin."
    },
    "/invoiceLogs/{logId}/items/{itemId}": {
      "schema": {
        "$ref": "#/entities/InvoiceLogItem"
      },
      "description": "Subkoleksi item barang untuk setiap dokumen log Proforma Invoice."
    },
    "/bankAccounts/{bankId}": {
      "schema": {
        "$ref": "#/entities/BankAccountRecord"
      },
      "description": "Menyimpan daftar rekening bank bersama seluruh admin di cloud."
    },
    "/invoiceCounters/{counterId}": {
      "schema": {
        "$ref": "#/entities/InvoiceCounter"
      },
      "description": "Menyimpan nomor urut otomatis Proforma Invoice per PT per bulan secara atomik."
    }
  }
}
